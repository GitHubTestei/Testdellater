-- Config Persistence Helper (pcall wrapped so it safely ignores if writefile isn't supported)
local CONFIG_FILE = "rb_suite_config.json"
local HttpService = game:GetService("HttpService")

local function SaveConfig()
    pcall(function()
        if writefile then
            local data = {
                Features = Features,
                Keybinds = {}
            }
            for k, v in pairs(Keybinds) do
                data.Keybinds[k] = v and v.Name or nil
            end
            writefile(CONFIG_FILE, HttpService:JSONEncode(data))
        end
    end)
end

local function LoadConfig()
    pcall(function()
        if readfile and isfile and isfile(CONFIG_FILE) then
            local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
            if data and data.Features then
                for k, v in pairs(data.Features) do
                    if Features[k] ~= nil then Features[k] = v end
                end
            end
            if data and data.Keybinds then
                for k, v in pairs(data.Keybinds) do
                    if Keybinds[k] ~= nil and v then
                        Keybinds[k] = Enum.KeyCode[v]
                    end
                end
            end
        end
    end)
end

