-- ────────────────────────────────────────────────
--  NAMES / HIGHLIGHTS LOGIC
-- ────────────────────────────────────────────────
local function Normalize(str)
    return (str or ""):lower():gsub("%s+", "")
end

local function ParseList(raw)
    local list = {}
    for token in (raw or ""):gmatch("%S+") do
        table.insert(list, Normalize(token))
    end
    return list
end

local function MatchesList(player, list)
    if #list == 0 or not player then return false end
    local name = Normalize(player.Name)
    local disp = Normalize(player.DisplayName)
    for _, item in ipairs(list) do
        if item ~= "" and (name:find(item, 1, true) or disp:find(item, 1, true)) then
            return true
        end
    end
    return false
end

local function GetFriends() return ParseList(Features.Friends) end
local function GetTargets() return ParseList(Features.Targets) end

local function IsFriend(player)
    return MatchesList(player, GetFriends())
end

local function IsTarget(player)
    if IsFriend(player) then return false end
    return MatchesList(player, GetTargets())
end

local function UpdateHighlights()
    local friends = GetFriends()
    local targets = GetTargets()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hl = p.Character:FindFirstChild("RB_Highlight")
            local isF = MatchesList(p, friends)
            local isT = not isF and MatchesList(p, targets)
            
            if isF or isT then
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "RB_Highlight"
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = p.Character
                end
                hl.FillColor = isF and FRIEND_COLOR or TARGET_COLOR
                hl.OutlineColor = isF and FRIEND_COLOR or TARGET_COLOR
            else
                if hl then hl:Destroy() end
            end
        end
    end
end

Players.PlayerAdded:Connect(function(p)
