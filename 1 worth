-- ────────────────────────────────────────────────
--  MAIN COMBAT & BOT LOOPS
-- ────────────────────────────────────────────────
local orbitAngle = 0

RunService.Heartbeat:Connect(function(dt)
    -- Rainbow Hue Shift
    rainbowPhase = (rainbowPhase + dt * 0.4) % 1

    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")

    -- No Slowdown
    if Features.NoSlowdown and myHum then
        myHum.WalkSpeed = 16
    end

    -- KillAura
    if Features.KillAura and myHum and myHum.Health > 0 then
        local target = GetNearestEnemy()
        if target and target.Character then
            local tHum = target.Character:FindFirstChildOfClass("Humanoid")
            if tHum then
                pcall(function()
                    ReplicatedStorage.Packages.Knit.Services.CombatService.RF.Hit:InvokeServer(tHum)
                end)
            end
        end
    end

    -- AutoBlock
    if Features.AutoBlock and myHum and myHum.Health > 0 then
        pcall(function()
            ReplicatedStorage.Packages.Knit.Services.CombatService.RF.Block:InvokeServer(true)
        end)
    end

    -- GrabSpam
    if Features.GrabSpam and myHum and myHum.Health > 0 then
        pcall(function()
            ReplicatedStorage.Packages.Knit.Services.CombatService.RF.Grab:InvokeServer()
        end)
    end

    -- Bot Follow / Orbit Logic
    if myHRP and not arc_inReturnWindow then
        local bTarget = GetBotTarget()
        if bTarget and bTarget.Character then
            local bHRP = bTarget.Character:FindFirstChild("HumanoidRootPart")
            if bHRP then
                if Features.Orbit then
                    orbitAngle = (orbitAngle + dt * 3) % (math.pi * 2)
                    local offset = Vector3.new(math.cos(orbitAngle) * 8, 0, math.sin(orbitAngle) * 8)
                    myHRP.CFrame = CFrame.new(bHRP.Position + offset, bHRP.Position)
                else
                    myHRP.CFrame = bHRP.CFrame * CFrame.new(0, 0, 3)
                end
            end
        end
    end
end)

