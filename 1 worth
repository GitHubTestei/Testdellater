    keybindButtons[name] = { button = bindBtn }

    bindBtn.MouseButton1Click:Connect(function()
        bindingFor = name
        bindBtn.Text = "..."
        bindBtn.TextColor3 = Color3.fromRGB(255, 220, 100)
    end)

    local clickArea = Instance.new("TextButton")
    clickArea.Size = UDim2.new(1, -85, 1, 0)
    clickArea.BackgroundTransparency = 1
    clickArea.Text = ""
    clickArea.Parent = frame

    return frame, clickArea, ind
end

local function ToggleFeature(name, ind)
    Features[name] = not Features[name]
    ind.BackgroundColor3 = Features[name] and Color3.fromRGB(80, 220, 120) or Color3.fromRGB(50, 50, 65)
    
    if name == "AntiRag" then
        if LocalPlayer.Character then task.spawn(arc_onCharacter, LocalPlayer.Character) end
    elseif name == "Friends" or name == "Targets" then
        UpdateHighlights()
    end
    
    SaveConfig()
end

local function CreateTextBox(name, placeholder, layoutOrder, onChange)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 42)
    frame.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    frame.BorderSizePixel = 0
    frame.LayoutOrder = layoutOrder
    frame.Parent = Scroll

    local fCorner = Instance.new("UICorner")
    fCorner.CornerRadius = UDim.new(0, 6)
    fCorner.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -20, 0, 16)
    label.Position = UDim2.new(0, 10, 0, 4)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Color3.fromRGB(150, 150, 170)
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 10
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -20, 0, 16)
    box.Position = UDim2.new(0, 10, 0, 20)
    box.BackgroundTransparency = 1
    box.Text = Features[name] or ""
    box.PlaceholderText = placeholder
    box.TextColor3 = Color3.fromRGB(220, 220, 240)
    box.PlaceholderColor3 = Color3.fromRGB(80, 80, 100)
    box.Font = Enum.Font.Gotham
    box.TextSize = 11
    box.TextXAlignment = Enum.TextXAlignment.Left
    box.ClearTextOnFocus = false
    box.Parent = frame

    box:GetPropertyChangedSignal("Text"):Connect(function()
        Features[name] = box.Text
        if onChange then onChange(box.Text) end
        SaveConfig()
    end)
end

local function FireReset(ind)
    ind.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health = 0 end
    end
    task.delay(0.3, function()
        ind.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
    end)
end

