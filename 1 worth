--  ARC ANTI-RAGDOLL SYSTEM (Original Architecture)
-- ────────────────────────────────────────────────
local arc_targetCFrame = CFrame.new(-502.844818, 10.1868954, -65.4427567, 0.560596228, 2.67291544e-09, -0.828089297, -2.95736768e-08, 1, -1.67928462e-08, 0.828089297, 3.39036497e-08, 0.560596228)
local arc_safeCFrame   = arc_targetCFrame + Vector3.new(0, 1, 0)
local ARC_DEFAULT_DELAY = 0.1
local ARC_GRAB_DELAY    = 3.5

local arc_connection        = nil
local arc_platStandConn     = nil
local arc_originalCFrame    = nil
local arc_hasCleanedThisRag = false
local arc_returnTask        = nil
local arc_inReturnWindow    = false
local arc_wasGrabbed        = false
local arc_platform          = nil
local arc_platformStandConn = nil

local function arc_resetState()
    arc_originalCFrame    = nil
    arc_returnTask        = nil
    arc_hasCleanedThisRag = false
    arc_inReturnWindow    = false
    arc_wasGrabbed        = false
end

local function arc_removePlatform()
    if arc_platformStandConn then arc_platformStandConn:Disconnect() arc_platformStandConn = nil end
    if arc_platform then pcall(function() arc_platform:Destroy() end) arc_platform = nil end
end

local function arc_spawnPlatform(position)
    arc_removePlatform()
    local W, H, D, T = 16, 10, 16, 1
    local floorY  = position.Y - 3.5
    local floorCY = floorY - T/2
    local ceilCY  = floorY + H + T/2
    local innerCY = floorY + H/2

    local model = Instance.new("Model")
    model.Name  = "ARC_SafeBox"
    model.Parent = workspace
    arc_platform = model

    local function makePart(size, cf)
        local p = Instance.new("Part")
        p.Size = size p.CFrame = cf p.Anchored = true p.CanCollide = true
        p.Locked = true p.Material = Enum.Material.SmoothPlastic
        p.BrickColor = BrickColor.new("Medium stone grey") p.Transparency = 0.4
        p.Parent = model
        return p
    end

    local cx, cz = position.X, position.Z
    makePart(Vector3.new(W,T,D), CFrame.new(cx, floorCY, cz))
    makePart(Vector3.new(W,T,D), CFrame.new(cx, ceilCY, cz))
    makePart(Vector3.new(W,H+T*2,T), CFrame.new(cx, innerCY, cz+D/2+T/2))
    makePart(Vector3.new(W,H+T*2,T), CFrame.new(cx, innerCY, cz-D/2-T/2))
    makePart(Vector3.new(T,H+T*2,D), CFrame.new(cx-W/2-T/2, innerCY, cz))
    makePart(Vector3.new(T,H+T*2,D), CFrame.new(cx+W/2+T/2, innerCY, cz))

    local topY = floorY
    arc_platformStandConn = RunService.Heartbeat:Connect(function()
        if not arc_platform or not arc_platform.Parent then arc_removePlatform() return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and hrp.Parent and hrp.Position.Y < topY then
            hrp.CFrame = CFrame.new(cx, topY + 3.5, cz)
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end)
end

local function arc_forceEndRagdoll(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        for _, st in ipairs({Enum.HumanoidStateType.Ragdoll, Enum.HumanoidStateType.Physics, Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.PlatformStanding}) do
            pcall(function() hum:SetStateEnabled(st, false) end)
        end
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
    for _, n in ipairs({"RagdollJoints", "NoCollisions", "Local Ragdoll"}) do
        local obj = char:FindFirstChild(n)
        if obj then obj:Destroy() end
    end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("Motor6D") then
            obj.Enabled = true
        elseif (obj:IsA("BaseConstraint") or obj:IsA("Attachment")) and obj.Name:lower():find("ragdoll") then
            obj:Destroy()
        end
    end
end

local function arc_onCharacter(char)
    local hrp = char:WaitForChild("HumanoidRootPart", 10)
    local hum = char:WaitForChild("Humanoid", 10)
    if not hrp or not hum then return end
    if arc_connection then arc_connection:Disconnect() arc_connection = nil end
    if arc_platStandConn then arc_platStandConn:Disconnect() arc_platStandConn = nil end
    arc_resetState()
    if arc_returnTask then task.cancel(arc_returnTask) arc_returnTask = nil end
    task.wait(2.5)
    if not Features.AntiRag then return end

    arc_platStandConn = hum:GetPropertyChangedSignal("PlatformStand"):Connect(function()
        if not Features.AntiRag or arc_inReturnWindow then return end
        if hum.PlatformStand then 
            arc_wasGrabbed = true 
            if not arc_originalCFrame then arc_originalCFrame = hrp.CFrame end
        end
    end)

    arc_connection = RunService.Heartbeat:Connect(function()
        if not Features.AntiRag or not char.Parent or not hrp.Parent then
            if arc_connection then arc_connection:Disconnect() arc_connection = nil end
            return
        end
        if arc_inReturnWindow then return end
        
        local isRagdolled = (hum:GetState() == Enum.HumanoidStateType.Physics)
        
        if isRagdolled then
            if not arc_originalCFrame then arc_originalCFrame = hrp.CFrame end
            
            if arc_wasGrabbed then
                if not arc_returnTask then
                    arc_inReturnWindow = true
                    local savedCFrame = arc_originalCFrame
                    local safePos = arc_safeCFrame.Position
                    
                    -- Teleport to safe spot and break ragdoll state
                    arc_spawnPlatform(safePos)
                    hrp.CFrame = CFrame.new(safePos.X, safePos.Y, safePos.Z)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    arc_forceEndRagdoll(char)
                    
                    arc_returnTask = task.delay(ARC_GRAB_DELAY, function()
                        arc_removePlatform()
                        if hrp and hrp.Parent and savedCFrame then
                            hrp.CFrame = savedCFrame
                            -- Clean up ragdoll state again upon teleporting back
                            arc_forceEndRagdoll(char)
                            task.delay(0.05, function()
                                if hrp and hrp.Parent then 
                                    hrp.AssemblyLinearVelocity = Vector3.new(0, -1, 0) 
                                end
                            end)
                        end
                        arc_resetState()
                    end)
                end
            else
                hrp.CFrame = arc_safeCFrame
                if not arc_hasCleanedThisRagdoll then
                    arc_forceEndRagdoll(char)
                    arc_hasCleanedThisRagdoll = true
                end
            end
        else
            if not arc_wasGrabbed and arc_originalCFrame and not arc_returnTask then
                arc_inReturnWindow = true
                local savedCFrame = arc_originalCFrame
                arc_returnTask = task.delay(ARC_DEFAULT_DELAY, function()
                    if hrp and hrp.Parent and savedCFrame then
                        hrp.CFrame = savedCFrame
                        arc_forceEndRagdoll(char)
                        task.delay(0.05, function()
                            if hrp and hrp.Parent then hrp.AssemblyLinearVelocity = Vector3.new(0, -1, 0) end
                        end)
                    end
                    arc_resetState()
                end)
            end
            arc_hasCleanedThisRagdoll = false
        end
    end)
end

