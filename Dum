-- NEW: insta return heartbeat connection (copied approach from anti-grab)
local _insta_returnConn = nil
local function _startInstaReturn(savedCFrame, duration)
    -- cancel any existing insta return watcher
    if _insta_returnConn then
        _insta_returnConn:Disconnect()
        _insta_returnConn = nil
    end
    if not savedCFrame then return end
    local startTime = tick()
    _insta_returnConn = RS.Heartbeat:Connect(function()
        if tick() - startTime > (duration or 0.8) then
            if _insta_returnConn then _insta_returnConn:Disconnect() _insta_returnConn = nil end
            return
        end
        local hrp = me.Character and me.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(function()
                hrp.CFrame = savedCFrame
                hrp.AssemblyLinearVelocity = Vector3.new(0, -1, 0)
            end)
        end
    end)
end

-- Insta logic refactored into a function so it can be called from the button and keybinds
-- Uses heartbeat-based return (no platform) to repeatedly set HRP back to the saved CFrame
-- Also uses gymLength/gymHeight/gymDistance for the CarryRequest arguments
local function performInsta()
    if instaBtn:GetAttribute("running") then return end
    instaBtn:SetAttribute("running", true)
    instaBtn.Text = "insta..."
    instaBtn.BackgroundColor3 = Color3.fromRGB(210,210,210)

    task.spawn(function()
        local queries = gymUsersList or {}
        if #queries == 0 then
            showNotification("No users entered for insta")
            instaBtn:SetAttribute("running", false)
            instaBtn.Text = "insta"
            instaBtn.BackgroundColor3 = Color3.fromRGB(255,255,255)
            return
        end

        local mySavedCFrame = nil
        if me.Character and me.Character:FindFirstChild("HumanoidRootPart") then
            mySavedCFrame = me.Character.HumanoidRootPart.CFrame
        end

        for _, query in ipairs(queries) do
            if not instaBtn:GetAttribute("running") then break end
            local targetPlayer = getTargetPlayer(query)
            if targetPlayer and targetPlayer.Character then
                -- Attempt carry once using gymLength/gymHeight/gymDistance
                pcall(function()
                    Replicated.CarryRequest:FireServer(table.unpack({
                        [1] = targetPlayer,
                        [2] = gymLength,
                        [3] = gymHeight,
                        [4] = gymDistance,
                        [5] = 0, [6] = 0, [7] = 0,
                    }))
                end)
                task.wait(0.12)
                -- Teleport to event (single)
                pcall(function()
                    Replicated.EventInviteSystem.EventTeleportEvent:FireServer()
                end)
                task.wait(0.08)
                -- Stop carry (drop)
                pcall(function()
                    Replicated.StopCarry:FireServer()
                end)

                -- Apply anti-grab-like heartbeat return: immediately attempt to set HRP back,
                -- then run the heartbeat that repeatedly enforces the saved CFrame for a short duration.
                if mySavedCFrame then
                    pcall(function()
                        local hrp = me.Character and me.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            hrp.CFrame = mySavedCFrame
                            hrp.AssemblyLinearVelocity = Vector3.new(0, -1, 0)
                        end
                    end)
                    _startInstaReturn(mySavedCFrame, 0.8)
                end

                task.wait(0.06)
            else
                task.wait(0.12)
            end
        end

        instaBtn:SetAttribute("running", false)
        instaBtn.Text = "insta"
        instaBtn.BackgroundColor3 = Color3.fromRGB(255,255,255)
    end)
end

