-- Start/stop gym cycle logic (respawn-safe)
local Replicated = game:GetService("ReplicatedStorage")

local function stopGymCycle()
    gymBanEnabled = false
    gymBtn.Text = "gym ban: off"
    gymBtn.BackgroundColor3 = Color3.fromRGB(255,255,255)
    -- ensure ban check is also off
    if gymBanCheck then
        gymBanCheck = false
        banCheckBtn.Text = "ban check: off"
        banCheckBtn.BackgroundColor3 = Color3.fromRGB(255,255,255)
    end
    if gymCycleThread then
        task.cancel(gymCycleThread)
        gymCycleThread = nil
    end
    -- always attempt to StopCarry when turning off
    pcall(function() Replicated.StopCarry:FireServer() end)
end

-- Modified startGymCycle: supports "all" (case-insensitive) to target every player
-- Uses gymLength (arg2), gymHeight (arg3), gymDistance (arg4)
local function startGymCycle()
    if gymCycleThread then return end
    gymCycleThread = task.spawn(function()
        while gymBanEnabled do
            local queries = gymUsersList or {}
            local delayVal = tonumber(gymDelay) or 1

            if #queries == 0 then
                task.wait(0.5)
            else
                -- Build list of target player objects.
                local targetPlayers = {}
                local isAll = (#queries == 1 and tostring(queries[1]):lower() == "all")
                if isAll then
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= me then table.insert(targetPlayers, p) end
                    end
                else
                    for _, q in ipairs(queries) do
                        local p = getTargetPlayer(q)
                        if p then table.insert(targetPlayers, p) end
                    end
                end

                if #targetPlayers == 0 then
                    task.wait(0.5)
                else
                    if gymBanCheck then
                        -- For each target: carry -> TP -> stop -> wait -> next
                        for _, targetPlayer in ipairs(targetPlayers) do
                            if not gymBanEnabled then break end
                            if targetPlayer and targetPlayer.Character then
                                pcall(function()
                                    Replicated.CarryRequest:FireServer(table.unpack({
                                        [1] = targetPlayer,
                                        [2] = gymLength,
                                        [3] = gymHeight,
                                        [4] = gymDistance,
                                        [5] = 0, [6] = 0, [7] = 0,
                                    }))
                                end)
                                task.wait(0.12)
                                pcall(function()
                                    Replicated.EventInviteSystem.EventTeleportEvent:FireServer()
                                end)
                                task.wait(0.12)
                                pcall(function()
                                    Replicated.StopCarry:FireServer()
                                end)
                            end
                            task.wait(delayVal)
                        end
                    else
                        -- Looping mode: iterate targets, carry -> TP -> wait -> stop (per-target)
                        for _, targetPlayer in ipairs(targetPlayers) do
                            if not gymBanEnabled then break end
                            if targetPlayer and targetPlayer.Character then
                                pcall(function()
                                    Replicated.CarryRequest:FireServer(table.unpack({
                                        [1] = targetPlayer,
                                        [2] = gymLength,
                                        [3] = gymHeight,
                                        [4] = gymDistance,
                                        [5] = 0, [6] = 0, [7] = 0,
                                    }))
                                end)
                                task.wait(0.12)
                                pcall(function()
                                    Replicated.EventInviteSystem.EventTeleportEvent:FireServer()
                                end)
                                task.wait(delayVal)
                                pcall(function()
                                    Replicated.StopCarry:FireServer()
                                end)
                                task.wait(0.12)
                            end
                        end
                    end
                end
            end
        end
        -- final cleanup
        pcall(function() Replicated.StopCarry:FireServer() end)
    end)
end

