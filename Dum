-- Bring implementation (ADDED)
-- Uses the same approach as your BringWithHeight_InstantRestore test:
-- CarryRequest -> wait(0.12) -> EventTeleportEvent -> IMMEDIATE local restore + heartbeat -> wait(0.08) -> StopCarry
local EVENT_CFRAME = CFrame.new(53.5, 8.298911, 118.149994)
local RETURN_DURATION = 0.8
local CARRY_WAIT = 0.12
local TELEPORT_WAIT = 0.08

local function round(n) return math.floor(n + 0.5) end

local function computeArgsForDesired(desiredPos, eventPos)
    -- Inversions per your notes:
    -- arg2 (length) inverted: eventX - desiredX
    -- arg3 (height) reversed: eventY - desiredY
    -- arg4 (distance) inverted: eventZ - desiredZ
    local a2 = eventPos.X - desiredPos.X
    local a4 = eventPos.Z - desiredPos.Z
    local a3 = eventPos.Y - desiredPos.Y
    return round(a2), round(a3), round(a4)
end

local function doCarryTeleportStop_InstantRestore(target, a2, a3, a4, mySavedCFrame)
    pcall(function()
        if Replicated:FindFirstChild("CarryRequest") then
            Replicated.CarryRequest:FireServer(table.unpack({
                [1] = target,
                [2] = a2,
                [3] = a3,
                [4] = a4,
                [5] = 0, [6] = 0, [7] = 0,
            }))
        else
            warn("CarryRequest remote not found")
        end
    end)

    task.wait(CARRY_WAIT)

    pcall(function()
        local evRoot = Replicated:FindFirstChild("EventInviteSystem")
        if evRoot and evRoot:FindFirstChild("EventTeleportEvent") then
            evRoot.EventTeleportEvent:FireServer()
        elseif Replicated:FindFirstChild("EventTeleportEvent") then
            Replicated.EventTeleportEvent:FireServer()
        else
            warn("EventTeleportEvent not found")
        end
    end)

    -- IMMEDIATE local restore and heartbeat
    pcall(function()
        local hrp = me.Character and me.Character:FindFirstChild("HumanoidRootPart")
        if hrp and mySavedCFrame then
            hrp.CFrame = mySavedCFrame
            hrp.AssemblyLinearVelocity = Vector3.new(0, -1, 0)
        end
    end)
    _startInstaReturn(mySavedCFrame, RETURN_DURATION)

    task.wait(TELEPORT_WAIT)

    pcall(function() if Replicated:FindFirstChild("StopCarry") then Replicated.StopCarry:FireServer() end end)
end

local function performBring()
    if bringBtn:GetAttribute("running") then return end
    bringBtn:SetAttribute("running", true)
    bringBtn.Text = "bringing..."
    bringBtn.BackgroundColor3 = Color3.fromRGB(210,210,210)

    task.spawn(function()
        local queries = gymUsersList or {}
        if #queries == 0 then
            showNotification("No users entered for bring")
            bringBtn:SetAttribute("running", false)
            bringBtn.Text = "bring"
            bringBtn.BackgroundColor3 = Color3.fromRGB(255,255,255)
            return
        end

        local mySavedCFrame = nil
        if me.Character and me.Character:FindFirstChild("HumanoidRootPart") then
            mySavedCFrame = me.Character.HumanoidRootPart.CFrame
        end

        local evPos = EVENT_CFRAME.Position

        -- find targets according to gymUsersList (same as gym ban input)
        local targetPlayers = {}
        local isAll = (#queries == 1 and tostring(queries[1]):lower() == "all")
        if isAll then
            for _, p in ipairs(Players:GetPlayers()) do if p ~= me then table.insert(targetPlayers, p) end end
        else
            for _, q in ipairs(queries) do
                local p = getTargetPlayer(q)
                if p then table.insert(targetPlayers, p) end
            end
        end

        if #targetPlayers == 0 then
            showNotification("No matching targets for bring")
            bringBtn:SetAttribute("running", false)
            bringBtn.Text = "bring"
            bringBtn.BackgroundColor3 = Color3.fromRGB(255,255,255)
            return
        end

        for _, targetPlayer in ipairs(targetPlayers) do
            if not bringBtn:GetAttribute("running") then break end
            if targetPlayer and targetPlayer.Character then
                local hrp = me.Character and me.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then
                    warn("Local player has no HumanoidRootPart")
                    break
                end
                local myPos = mySavedCFrame and mySavedCFrame.Position or hrp.Position

                local a2, a3, a4 = computeArgsForDesired(myPos, evPos)
                local predicted = Vector3.new(evPos.X + a2, evPos.Y - a3, evPos.Z + a4)
                local predDist = (predicted - myPos).Magnitude

                print(("Bringing %s | arg2=%d arg3=%d arg4=%d | predicted distance to me = %.4f")
                    :format(targetPlayer.Name, a2, a3, a4, predDist))

                doCarryTeleportStop_InstantRestore(targetPlayer, a2, a3, a4, mySavedCFrame)

                -- No additional delay between targets (per request)
            end
        end

        bringBtn:SetAttribute("running", false)
        bringBtn.Text = "bring"
        bringBtn.BackgroundColor3 = Color3.fromRGB(255,255,255)
    end)
end

