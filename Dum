UIS.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.LeftControl then
        frame.Visible = not frame.Visible
        return
    end
    
    if bindingFor then
        local currentFeature = bindingFor
        bindingFor = nil
        if input.KeyCode ~= Enum.KeyCode.Escape then
            Keybinds[currentFeature] = input.KeyCode
            if bindButtons[currentFeature] then
                bindButtons[currentFeature].Text = tostring(input.KeyCode):gsub("Enum.KeyCode.", "")
            end
        else
            Keybinds[currentFeature] = nil
            if bindButtons[currentFeature] then
                bindButtons[currentFeature].Text = "bind"
            end
        end
        return
    end
    
    for featureName, registeredKey in pairs(Keybinds) do
        if registeredKey and input.KeyCode == registeredKey then
            toggleFeature(featureName)
        end
    end
end)

