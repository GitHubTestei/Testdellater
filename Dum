        tpwalkBtn.Text = tpwalkEnabled and "tpwalk: on" or "tpwalk: off"
        tpwalkBtn.BackgroundColor3 = tpwalkEnabled and Color3.fromRGB(210,210,210) or Color3.fromRGB(255,255,255)
        if tpwalkEnabled then
            if tpwalkingConn then tpwalkingConn:Disconnect() end
            tpwalkingConn = RS.Heartbeat:Connect(function(delta)
                local char = me.Character
                local hum = char and char:FindFirstChildWhichIsA("Humanoid")
                if char and hum and hum.Parent and hum.MoveDirection.Magnitude > 0 then
                    char:TranslateBy(hum.MoveDirection * tpwalkSpeed * delta * 10)
                end
            end)
        else
            if tpwalkingConn then tpwalkingConn:Disconnect() tpwalkingConn = nil end
        end
    elseif name == "FlyJump" then
        flyjumpEnabled = not flyjumpEnabled
        flyjumpBtn.Text = flyjumpEnabled and "flyjump: on" or "flyjump: off"
        flyjumpBtn.BackgroundColor3 = flyjumpEnabled and Color3.fromRGB(210,210,210) or Color3.fromRGB(255,255,255)
        if flyjumpEnabled then
            if flyjumpConn then flyjumpConn:Disconnect() end
            flyjumpConn = UIS.JumpRequest:Connect(function()
                local hum = me.Character and me.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
            end)
        else
            if flyjumpConn then flyjumpConn:Disconnect() flyjumpConn = nil end
        end
    elseif name == "AutoClicker" then
        autoclickerEnabled = not autoclickerEnabled
        autoclickBtn.Text = autoclickerEnabled and "autoclicker: on" or "autoclicker: off"
        autoclickBtn.BackgroundColor3 = autoclickerEnabled and Color3.fromRGB(210,210,210) or Color3.fromRGB(255,255,255)
        if autoclickerEnabled then
            showNotification("VIM clicks on mobile are a little buggy, when turned off, give it 10 seconds before you could move")
            if autoclickerConn then autoclickerConn:Disconnect() end
            autoclickerConn = task.spawn(function()
                while autoclickerEnabled do
                    local camera = workspace.CurrentCamera
                    if camera then
                        local x = camera.ViewportSize.X / 2
                        local y = camera.ViewportSize.Y / 2
                        pcall(function()
                            VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
                            task.wait(0.01)
                            VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
                        end)
                    end
                    task.wait(1 / autoclickerCps)
                end
            end)
        else
            showNotification("VIM clicks on mobile devices are buggy, please give it 10 seconds before you can move")
            if autoclickerConn then
                task.cancel(autoclickerConn)
                autoclickerConn = nil
            end
        end
    elseif name == "PromptDelete" then
        promptDeleteEnabled = not promptDeleteEnabled
        promptDeleteBtn.Text = promptDeleteEnabled and "no prompts: on" or "no prompts: off"
        promptDeleteBtn.BackgroundColor3 = promptDeleteEnabled and Color3.fromRGB(210,210,210) or Color3.fromRGB(255,255,255)
        
        if promptDeleteEnabled then
            -- Store original distances
            originalPromptDistances = {}
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("ProximityPrompt") then
                    originalPromptDistances[v] = v.MaxActivationDistance
                    v.MaxActivationDistance = 0
                end
            end
            
            if promptDeleteConn then promptDeleteConn:Disconnect() end
            promptDeleteConn = me.PlayerGui.ChildAdded:Connect(function(child)
                if child.Name == "PromptFavorite" then
                    task.defer(function()
                        pcall(function() child:Destroy() end)
                    end)
                end
            end)
            
            local existing = me.PlayerGui:FindFirstChild("PromptFavorite")
            if existing then
                pcall(function() existing:Destroy() end)
            end
        else
            -- Restore original distances
            for prompt, dist in pairs(originalPromptDistances) do
                if prompt and prompt.Parent then
                    prompt.MaxActivationDistance = dist
                end
            end
            originalPromptDistances = {}
            
            if promptDeleteConn then
                promptDeleteConn:Disconnect()
                promptDeleteConn = nil
            end
        end
    elseif name == "Insta" then
        -- call the refactored insta function so binds and button behave the same
        performInsta()
    end
end

