    local lerpFactor = (math.sin(pinkWhiteHue * math.pi * 2) + 1) / 2
    local currentColor = Color3.fromRGB(255, 182, 193):Lerp(Color3.fromRGB(255, 255, 255), lerpFactor)

    if not hitboxAuraEnabled then
