                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health <= 0 then continue end
                if isInList(p, friendsList) then continue end
                if #targetsList > 0 and not isInList(p, targetsList) then continue end

                local root = p.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    local dist = (myRoot.Position - root.Position).Magnitude
                    if dist <= hitboxDistance then
                        activeThisFrame[p] = true
                        pcall(function()
                            root.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                            root.Transparency = 0.95
                            root.Color = currentColor
                            root.Material = Enum.Material.Neon
                            root.CanCollide = false
                            root.Shape = Enum.PartType.Ball
                        end)
                    end
                end
            end
        end
    else
        local nearest, shortest = nil, hitboxDistance
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= me and p.Character then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health <= 0 then continue end
                if isInList(p, friendsList) then continue end
                if #targetsList > 0 and not isInList(p, targetsList) then continue end

                local root = p.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    local dist = (myRoot.Position - root.Position).Magnitude
                    if dist <= shortest then
                        nearest = p
                        shortest = dist
                    end
                end
            end
        end

        if nearest and nearest.Character then
            local root = nearest.Character:FindFirstChild("HumanoidRootPart")
            if root then
                activeThisFrame[nearest] = true
                pcall(function()
                    root.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                    root.Transparency = 0.95
                    root.Color = currentColor
                    root.Material = Enum.Material.Neon
                    root.CanCollide = false
                    root.Shape = Enum.PartType.Ball
                end)
            end
        end
    end

    for p, _ in pairs(modifiedHitboxes) do
        if not activeThisFrame[p] then
            resetHitbox(p)
            modifiedHitboxes[p] = nil
        end
    end

    for p, _ in pairs(activeThisFrame) do
        modifiedHitboxes[p] = true
    end
end)

