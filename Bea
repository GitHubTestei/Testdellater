RunService.Heartbeat:Connect(function(dt)
    if not Features.Bot or Features.Bot == "" then return end
    
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not myHrp or not myHum or myHum.Health <= 0 then return end
    
    local targetPlr = nil
    local searchTerm = string.lower(Features.Bot)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if string.find(string.lower(p.Name), searchTerm) or string.find(string.lower(p.DisplayName), searchTerm) then
                targetPlr = p
                break
            end
        end
    end
    
    if targetPlr and targetPlr.Character then
        local targetHrp = targetPlr.Character:FindFirstChild("HumanoidRootPart")
        local targetHum = targetPlr.Character:FindFirstChildOfClass("Humanoid")
        if targetHrp and targetHum and targetHum.Health > 0 then
            if targetPlr ~= lastTarget then
                lastTarget = targetPlr
                orbitAngle = math.rad(math.random(0, 360))
                orbitDistance = math.random(50, 70) / 10
                orbitSpeed = math.random(100, 150) / 10
            end

            if Features.Orbit then
                orbitAngle = (orbitAngle + dt * orbitSpeed) % (math.pi * 2)
                local x = math.cos(orbitAngle) * orbitDistance
                local z = math.sin(orbitAngle) * orbitDistance
                myHrp.CFrame = CFrame.new(targetHrp.Position + Vector3.new(x, 0, z), targetHrp.Position)
            else
                myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 1.5)
            end
        end
    end
end)

